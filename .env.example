# ==============================================================================
# Woobi Corporate Modular Monorepo - Backend Environment Configuration Template
# ==============================================================================
# NOTE: Never commit live production secrets, certificates, or tokens to source control.
# Copy this file to .env for local development.

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
NODE_ENV=development

# Authentication & Cryptographic Signing
# Minimum 32-character random string for HMAC-SHA256 session token signatures
WOOBI_AUTH_SECRET=your-secure-random-32-byte-secret-key-here
TOKEN_EXPIRY_HOURS=24

# Database & File Storage Directories (Relative to repo root or absolute paths)
WOOBI_DATA_DIR=./data
WOOBI_STORAGE_DIR=./uploads

# Security & CORS
# Comma-separated list of permitted web origins
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5000,http://127.0.0.1:5000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

# Development Entitlement Verification Key (Dev testing only)
DEV_ENTITLEMENT_VERIFICATION_KEY=WOOBI_DEV_VERIFIED_UPGRADE
