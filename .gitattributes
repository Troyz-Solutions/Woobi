# Auto-detect text files and normalize line endings to LF
* text=auto

# Explicit text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.cs text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary 3D Models & Textures (Prevent Git from corrupting byte sequences)
*.glb binary
*.gltf binary
*.blend binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
