{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ES2022",
    "checkJs": false,
    "lib": ["DOM", "DOM.Iterable", "ES2022"]
  },
  "include": [
    "modules/**/*",
    "scripts/**/*",
    "server.js",
    "app.js",
    "studio3d.js",
    "wardrobe3d.js"
  ],
  "exclude": [
    "node_modules",
    "android-app",
    "libs"
  ]
}
